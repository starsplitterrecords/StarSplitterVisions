  "rewrites": [
    {
      "source": "/series",
      "destination": "/index.html"
    },
    {
      "source": "/series/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/read/:slug/:page",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/press",
      "destination": "/index.html"
    }
  ]
}
